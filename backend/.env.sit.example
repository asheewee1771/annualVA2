# SIT settings for a local run of the `sit` profile. Copy to .env.sit (ignored by git) in backend/ and run
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=sit
# Only keys you override belong in .env.sit: an empty value overrides the default with an empty string (ADR 0005).
# Real environment variables take precedence over this file. In a deployed SIT, set them in the environment.
# Every value below that looks real is a placeholder; none is a SIT value until ticket 56 records it.

# --- Secrets: no default, the application refuses to start without them ---
ANNUALVA_DB_PASSWORD=change-me
# Base64 of the PKCS#8 PEM / SPKI PEM block of the EC P-521 key whose public half is registered with MCC SSO
# for the login client (see scripts/gen-dev-keys.sh for the format; never reuse the dev-mcc key).
ANNUALVA_MCC_SIGNING_PRIVATE=
ANNUALVA_MCC_SIGNING_PUBLIC=
# Exactly two VA POC email addresses, comma-separated (story 75).
ANNUALVA_VA_POCS=va.poc.one@example.invalid,va.poc.two@example.invalid

# --- Database (defaults: the compose PostgreSQL) ---
#ANNUALVA_DB_URL=jdbc:postgresql://localhost:5432/annualva
#ANNUALVA_DB_USERNAME=annualva

# --- MCC SSO, supplied by the MTM onboarding (defaults: the mock Keycloak realm) ---
#ANNUALVA_MCC_ISSUER=
#ANNUALVA_MCC_AUTHORIZATION_URI=
#ANNUALVA_MCC_TOKEN_URI=
#ANNUALVA_MCC_JWK_SET_URI=
#ANNUALVA_MCC_USER_INFO_URI=
#ANNUALVA_MCC_LOGIN_CLIENT_ID=
# Keycloak kc_idp_hint selecting the staff identity provider.
#ANNUALVA_MCC_IDP_HINT=
# The kid the EC public key is registered under.
#ANNUALVA_MCC_SIGNING_KID=
# The CA of MCC SSO's SIT certificate. Default: classpath:sit/mcc-sso-ca.crt
#ANNUALVA_MCC_TRUST_CERTIFICATE=

# --- Sign-in and step-up: what SIT shows MCC SSO emits (ticket 56) ---
#ANNUALVA_SIGNIN_REQUIRE_MFA_CLAIM=true
#ANNUALVA_SIGNIN_REQUIRE_VERIFIED_EMAIL=true
#ANNUALVA_SIGNIN_MFA_AMR_VALUES=mfa,otp,hwk
#ANNUALVA_SIGNIN_MFA_ACR_VALUES=
# prompt-login or full-sign-in
#ANNUALVA_STEPUP_MODE=prompt-login

# --- Mail through MCNS (ticket 57 records the template ids; defaults are placeholders) ---
# The address every mailed link starts with: https, no trailing slash.
#ANNUALVA_APP_URL=https://localhost:8443
#ANNUALVA_MAIL_TEMPLATE_RETURNED_FOR_REWORK=
#ANNUALVA_MAIL_TEMPLATE_OVERDUE=
#ANNUALVA_MAIL_TEMPLATE_REGISTER_CHANGE=
#ANNUALVA_MAIL_TEMPLATE_REMINDER_DUE_SOON=
#ANNUALVA_MAIL_TEMPLATE_REMINDER_DUE=
#ANNUALVA_MAIL_TEMPLATE_OVERDUE_WEEKLY=
#ANNUALVA_MAIL_TEMPLATE_REMINDER_COPY=
